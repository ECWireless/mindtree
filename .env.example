# PostgreSQL
DATABASE_URL=
# Optional direct connection for migrations; pooled DATABASE_URL is the runtime requirement
DATABASE_URL_UNPOOLED=

# Better Auth and Google OAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated HTTP(S) origins allowed to submit authentication requests
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=

# OpenAI server access
OPENAI_API_KEY=

# Stable 32-byte base64url key for owner recovery of public share links
SHARE_LINK_ENCRYPTION_KEY=

# Optional comma-separated development HTTP(S) origins or hostnames accepted by Next.js
NEXT_ALLOWED_DEV_ORIGINS=
